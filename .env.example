# Copy to `.env.local` (development) or set in the hosting provider (production).

# Canonical public origin of the marketing site — no trailing slash.
# Canonical links, hreflang alternates, the sitemap, robots.txt and the
# Open Graph image are all derived from it.
NEXT_PUBLIC_SITE_URL=https://www.workflownets.com

# Backend hosts. The second is used only when the first stops answering.
NEXT_PUBLIC_API_ORIGIN=https://work.isradev.shop
NEXT_PUBLIC_API_ORIGIN_FALLBACK=https://workflow.aliservice.site
