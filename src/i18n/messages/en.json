  "Index": {
    "title": "Workflow",
    "heroTitle": "Forget Task Chaos Manage Your <cyan>Projects</cyan> and Unite Your <cyan>Team in One Place</cyan>",
    "heroSubtitle": "Workflow gives you the ultimate command center to manage agile teams, success, organize plans, and master your works in an intuitive platform.",
    "heroCta": "Get Started Free",
    "heroVideo": "Contact Us",
    "featuresTitle": "What is <cyan>Workflow?</cyan>",
    "featuresDesc": "Workflow is a powerful software platform designed to effortlessly manage tasks and bring your team together in one workspace. Instead of scattering your projects, files, and communication across multiple disconnected apps, Workflow puts everything at your fingertips, so your team works streamlined and boosts overall productivity.",
    "coreFeaturesTitle": "Core <cyan>Features</cyan>",
